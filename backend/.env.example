MONGODB_URI=your_mongodb_connection_string
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# AI Screenshot Vision Keys (100% Free):
# You can provide a single key or multiple comma-separated keys for auto-failover:
# GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq Cloud Free Vision API key (fallback from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

